#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
prefix="meteor-tab"
session="${prefix}-$(date +%Y%m%d-%H%M%S)-$$"
window_name="$(basename "$PWD")"

tmux new-session -d -s "$session" -n "$window_name"
"$script_dir/tmux-managed-sessions" add "$session" >/dev/null 2>&1 || true
"$script_dir/tmux-session-title" set "$session" "${YAKUAKE_TAB_TITLE:-$window_name}" >/dev/null 2>&1 || true
exec tmux attach-session -t "$session"

#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${TMUX:-}" ]]; then
  echo "not inside tmux" >&2
  exit 1
fi

session="$(tmux display-message -p '#S')"
[[ "$session" == meteor-tab-* ]] || {
  echo "refusing to close non-managed tmux session: $session" >&2
  exit 1
}

tmux-managed-sessions remove "$session" >/dev/null 2>&1 || true
tmux-session-title remove "$session" >/dev/null 2>&1 || true
tmux kill-session -t "$session"

resurrect_save="$HOME/.tmux/plugins/tmux-resurrect/scripts/save.sh"
if [[ -x "$resurrect_save" ]]; then
  "$resurrect_save" quiet >/dev/null 2>&1 || true
fi

#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/meteor-tmux/titles"
mkdir -p "$state_dir"

title_file() {
  local session="${1:?session required}"
  printf '%s/%s\n' "$state_dir" "$session"
}

case "${1:-get}" in
  set)
    session="${2:?session required}"
    title="${3:?title required}"
    printf '%s\n' "$title" >"$(title_file "$session")"
    ;;
  get)
    session="${2:?session required}"
    file="$(title_file "$session")"
    [[ -r "$file" ]] && cat "$file"
    ;;
  remove)
    session="${2:?session required}"
    rm -f "$(title_file "$session")"
    ;;
  *)
    echo "usage: tmux-session-title [set SESSION TITLE|get SESSION|remove SESSION]" >&2
    exit 2
    ;;
esac

#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/yakuake-snapshot"
sessions_dir="$state_dir/sessions"
current_instance_file="$state_dir/current-instance"
current_session_file="$state_dir/current-session"
previous_session_file="$state_dir/previous-session"
lock_file="$state_dir/session.lock"

read_first_line() {
  local file=$1
  [[ -r "$file" ]] && sed -n '1p' "$file" || true
}

session_has_tabs() {
  local session_id=$1
  local first_tab
  [[ -n "$session_id" ]] || return 1
  first_tab="$(find "$sessions_dir/$session_id/tabs" -mindepth 1 -maxdepth 1 -type d -print -quit 2>/dev/null || true)"
  [[ -n "$first_tab" ]]
}

mkdir -p "$sessions_dir"

lock_held=0
if command -v flock >/dev/null 2>&1; then
  exec 9>"$lock_file"
  flock 9
  lock_held=1
fi

boot_id="$(sed -n '1p' /proc/sys/kernel/random/boot_id 2>/dev/null || printf '%s\n' unknown-boot)"
yakuake_pid="$(pgrep -u "$UID" -x yakuake 2>/dev/null | sort -n | head -n 1 || true)"
[[ -n "$yakuake_pid" ]] || yakuake_pid="no-yakuake"

instance_id="${boot_id}:${yakuake_pid}"
current_instance="$(read_first_line "$current_instance_file")"
session_id="$(read_first_line "$current_session_file")"

if [[ "$current_instance" != "$instance_id" || -z "$session_id" || ! -d "$sessions_dir/$session_id" ]]; then
  if session_has_tabs "$session_id"; then
    printf '%s\n' "$session_id" >"$previous_session_file"
  fi

  session_id="$(date +%Y%m%d-%H%M%S)-yakuake-${yakuake_pid}"
  mkdir -p "$sessions_dir/$session_id/tabs"
  printf '%s\n' "$instance_id" >"$current_instance_file"
  printf '%s\n' "$session_id" >"$current_session_file"
  printf '%s\n' "$instance_id" >"$sessions_dir/$session_id/instance"
  date -Is >"$sessions_dir/$session_id/created-at"
else
  mkdir -p "$sessions_dir/$session_id/tabs"
fi

tab_id="$(date +%Y%m%d-%H%M%S)-$$"
tab_dir="$sessions_dir/$session_id/tabs/$tab_id"
log_file="$tab_dir/output.log"

mkdir -p "$tab_dir"
printf '%s\n' "$session_id" >"$tab_dir/session"
printf '%s\n' "$PWD" >"$tab_dir/cwd"
printf '%s\n' "$(basename "$PWD")" >"$tab_dir/title"
: >"$tab_dir/last_command"
: >"$log_file"

if (( lock_held )); then
  flock -u 9 || true
  exec 9>&-
fi

export YAKUAKE_SNAPSHOT_TAB_ID="$tab_id"
export YAKUAKE_SNAPSHOT_TAB_DIR="$tab_dir"
export YAKUAKE_SNAPSHOT_LOG="$log_file"
export ZDOTDIR="${ZDOTDIR:-$HOME}"

exec script -qef "$log_file" -c 'zsh -i'
